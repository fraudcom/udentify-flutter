         no-title-bar theme), so moving them into OcrHostActivity does not change their look. -->
    <style name="UdentifyOcrHostTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
